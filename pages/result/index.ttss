.page{padding:16px;background:#f5f5f7;min-height:100vh}
.header{margin:8px 0 12px}
.title{font-size:22px;font-weight:600}
.list{display:flex;flex-direction:column;gap:12px}
.card{background:#fff;border-radius:12px;overflow:hidden;box-shadow:0 2px 8px rgba(0,0,0,.06);display:flex}

/* 图片容器样式 */
.image-container{
  position:relative;
  width:96px;
  height:96px;
  flex-shrink:0;
}

.cover{
  width:100%;
  height:100%;
  object-fit:cover;
}

/* PlantNet图片标识 */
.image-badge{
  position:absolute;
  top:4px;
  left:4px;
  background:rgba(60,137,255,0.9);
  color:#fff;
  padding:2px 6px;
  border-radius:4px;
  font-size:10px;
}

.badge-text{
  font-size:10px;
  font-weight:500;
}

/* 多图片指示器 */
.multi-image-indicator{
  position:absolute;
  top:4px;
  right:4px;
  background:rgba(0,0,0,0.6);
  color:#fff;
  padding:2px 6px;
  border-radius:4px;
}

.indicator-text{
  font-size:10px;
  font-weight:500;
}

/* 信息区域样式 */
.info{
  flex:1;
  padding:12px;
  display:flex;
  flex-direction:column;
  justify-content:center;
}

.name{
  font-size:16px;
  font-weight:600;
  margin-bottom:6px;
  color:#1d1d1f;
}

.tags{
  font-size:12px;
  color:#8e8e93;
  margin-bottom:4px;
}

.reason{
  font-size:12px;
  color:#3c89ff;
  margin-top:4px;
}

/* 图片来源说明 */
.image-source{
  font-size:10px;
  color:#34c759;
  margin-top:2px;
  font-weight:500;
}
