.page{padding:16px;background:#f5f5f7;min-height:100vh}
.header{margin:8px 0 12px}
.title{font-size:22px;font-weight:600}
.list{display:flex;flex-direction:column;gap:12px}
.card{background:#fff;border-radius:12px;overflow:hidden;box-shadow:0 2px 8px rgba(0,0,0,.06);display:flex}
.cover{width:96px;height:96px}
.info{flex:1;padding:12px;display:flex;flex-direction:column;justify-content:center}
.name{font-size:16px;font-weight:600;margin-bottom:6px}
.tags{font-size:12px;color:#8e8e93}

