<view class="landing">
  <view class="hero">
    <image class="hero-illu" src="/images/p1.png" mode="aspectFill"></image>
    <view class="hero-title">
      <text>为你找到</text>
      <text class="highlight">最适合的绿植</text>
    </view>
    <button class="start-btn" bindtap="goQuestion">开始测试</button>
    <text class="disclaimer">*本产品测试结果可靠*</text>
  </view>
</view>
