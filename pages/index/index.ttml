<view class="container ios">
  <view class="header-large">
    <text class="large-title">推荐绿植</text>
    <button class="pill-btn" bindtap="goQuestion">去答题</button>
  </view>

  <view class="group">
    <block tt:for="{{list}}" tt:key="id">
      <view class="cell" data-id="{{item.id}}" bindtap="goDetail">
        <image class="cell-cover" src="{{item.cover}}" mode="aspectFill" />
        <view class="cell-body">
          <view class="cell-title">{{item.name}}</view>
          <view class="cell-subtitle">{{item.tags && item.tags.join(' / ')}}</view>
        </view>
      </view>
    </block>
  </view>

  <view class="actions">
    <button class="btn-ghost" tt:if="{{!loading}}" bindtap="loadPlants">刷新</button>
    <button class="btn-primary" tt:if="{{loading}}" disabled>加载中...</button>
  </view>
</view>