/* Landing page inspired by the provided mock */
page{background:#f7f7fb}
.landing{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:24px}
.hero{width:100%;max-width:560px;background:#fff;border-radius:20px;box-shadow:0 8px 30px rgba(17,20,37,.08);padding:32px 24px;display:flex;flex-direction:column;align-items:center}
.hero-illu{width:100%;height:200px;border-radius:16px;margin-bottom:16px}
.hero-title{display:flex;flex-direction:column;align-items:center;gap:6px;margin:8px 0 20px}
.hero-title text{font-size:22px;color:#111;font-weight:700}
.hero-title .highlight{font-size:26px;color:#1f2a6b}
.start-btn{width:72%;padding:14px 0;border-radius:999px;background:#232e6b;color:#fff;font-weight:700}
.disclaimer{margin-top:16px;color:#8e8e93;font-size:12px}
