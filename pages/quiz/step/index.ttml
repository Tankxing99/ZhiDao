<view class="page">
  <block tt:if="{{loading}}">
    <view class="loading">加载中...</view>
  </block>
  <block tt:elif="{{!question}}">
    <view class="empty">暂无题目</view>
  </block>
  <block tt:else>
    <view class="header">
      <!-- 隐藏进度显示 -->
    </view>
    <view class="banner">
      <image class="illustration" src="/images/p6.png" mode="aspectFill"></image>
    </view>
    <view class="qcard">
      <text class="qtitle">{{question.title}}</text>
      <!-- 单选题：沿用按钮样式 -->
      <view class="options" tt:if="{{question.type!=='multiple'}}">
        <block tt:for="{{question.options}}" tt:key="value" tt:for-item="opt">
          <button class="opt {{selected===opt.value?'active':''}}" data-value="{{opt.value}}" bindtap="onSelect">{{opt.label}}</button>
        </block>
      </view>
      <!-- 多选题：使用 checkbox-group -->
      <view class="options" tt:elif="{{question.type==='multiple'}}">
        <checkbox-group bindchange="onMultiChange">
          <label class="opt checkbox" tt:for="{{question.options}}" tt:key="value" tt:for-item="opt">
            <checkbox value="{{opt.value}}" checked="{{selectedMulti.indexOf(opt.value) >= 0}}"/>
            <text class="checkbox-label">{{opt.label}}</text>
          </label>
        </checkbox-group>
      </view>
    </view>
    <view class="footer">
      <button class="nav prev" bindtap="goPrev" tt:if="{{idx>0}}">上一题</button>
      <button class="nav next" bindtap="goNext">{{idx===total-1?'提交':'下一题'}}</button>
    </view>
  </block>
</view>
