page{background:#ffffff}
.page{min-height:100vh;padding:16px}
.header{display:flex;align-items:center;justify-content:flex-start;margin:8px 0}
.progress{font-size:18px;color:#e5484d;font-weight:700}
.banner{margin:6px 0 12px}
.illustration{width:100%;height:140px;border-radius:12px;background:#f2f2f7}
.qcard{background:#fff;border-radius:16px;padding:14px 12px;box-shadow:0 4px 14px rgba(0,0,0,.06)}
.qtitle{font-size:18px;font-weight:700;color:#111;margin:6px 0 10px;line-height:1.4}
.options{display:flex;flex-direction:column;gap:12px}
.opt{background:#e9e9ec;border-radius:999px;padding:12px 16px;color:#111;text-align:center;font-size:16px}
.opt.active{background:#232e6b;color:#fff}
.footer{display:flex;gap:12px;margin-top:16px}
.nav{flex:1;border-radius:12px;padding:12px 0;background:#232e6b;color:#fff}
.nav.prev{background:#f0f0f0;color:#111}
.loading,.empty{padding:40px 0;text-align:center;color:#8e8e93}

